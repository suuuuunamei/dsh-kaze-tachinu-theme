{
  "name": "dsh-kaze-tachinu-theme",
  "version": "1.0.0",
  "description": "Kaze Tachinu (The Wind Rises) theme for DeepSeek Harness Web GUI — dynamic Cordis plugin source (host + client halves) plus an installable dsh bundle, with wallpaper/logo assets",
  "type": "module",
  "license": "MIT",
  "main": "bundle/host.js",
  "exports": {
    ".": "./bundle/host.js",
    "./client": "./bundle/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "bundle",
    "assets",
    "cordis.patch.yml",
    "docs/screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snamei/dsh-kaze-tachinu-theme.git",
    "directory": "."
  },
  "author": "dsh-kaze-tachinu-theme contributors",
  "homepage": "https://github.com/Snamei/dsh-kaze-tachinu-theme#readme",
  "bugs": {
    "url": "https://github.com/Snamei/dsh-kaze-tachinu-theme/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "the-wind-rises",
    "kaze-tachinu",
    "kaze-tachinu-theme",
    "ghibli",
    "miyazaki",
    "anime"
  ]
}
